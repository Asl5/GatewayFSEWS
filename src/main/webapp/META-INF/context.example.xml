<?xml version="1.0" encoding="UTF-8"?>

<Context path="/GatewayFSE">

    <Resource name="jdbc/FSEGatewayDataSource"
              auth="Container"
              type="javax.sql.DataSource"
              factory="com.mycompany.gatewayfse.EncryptedDataSourceFactory"
              driverClassName="oracle.jdbc.OracleDriver"
              url="jdbc:oracle:thin:@//HOST_DB:1521/SERVICE_NAME"
              username="DB_USERNAME"
              password="ENC(PASSWORD_CIFRATA_DA_GENERARE)"
              maxActive="10"
              initialSize="5"
              validationQuery="SELECT 1 FROM DUAL"
              testOnBorrow="true"
              useJmx="false"/>

</Context>